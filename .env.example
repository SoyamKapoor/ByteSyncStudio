# ==============================================================================
# ByteSync Studio — Environment Configuration Template
# Copy this file to .env or configure in your deployment dashboard.
# Never commit secrets to version control.
# ==============================================================================

# Core Application Settings
PORT=3000
SITE_URL=http://localhost:3000

# Supabase PostgreSQL Database (Section 16)
# Retrieve from: Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Transactional Email via Gmail SMTP (Section 17)
# Use your Gmail address and a 16-character Google App Password (not your personal password)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
EMAIL_FROM="ByteSync Studio <your-email@gmail.com>"
BUSINESS_NOTIFICATION_EMAIL=your-email@gmail.com

# Administrator Console Authentication (Section 19)
ADMIN_USERNAME=admin@bytesyncstudio.com
ADMIN_PASSWORD=bytesync2026

# Modular Payment Gateway (Section 18 - Optional for Paid Consultations)
PAYMENT_PROVIDER=stripe
PAYMENT_SECRET_KEY=sk_test_placeholder
PAYMENT_WEBHOOK_SECRET=whsec_placeholder
